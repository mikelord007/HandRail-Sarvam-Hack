    <string name="welcome_kicker">சற்று பொறுங்கள். நான் உங்களை வழிநடத்துகிறேன்.</string>
    <string name="welcome_body">நீங்கள் என்ன செய்ய விரும்புகிறீர்கள் என்று உங்கள் மொழியில் சொல்லுங்கள். நான் திரையை உரக்கப் படிக்கிறேன், அல்லது உங்களுக்காக தட்டுகிறேன் — ஒவ்வொரு படியையும் செய்யும் முன் சொல்கிறேன்.</string>
    <string name="begin">தொடங்கு</string>
    <string name="welcome_footer">சுமார் ஒரு நிமிடம் ஆகும் · நான்கு அனுமதிகள்</string>

    <string name="language_screen_title">நான் எந்த மொழியில் பேச வேண்டும்?</string>
    <string name="language_screen_body">நான் இதே மொழியில் கேட்பேன் கூட. அமைப்புகளில் எப்போது வேண்டுமானாலும் இதை மாற்றலாம்.</string>
    <string name="language_screen_count">%1$d மொழிகள் · Sarvam மேலும் சேர்க்கும்</string>

    <string name="voice_screen_title">நான் யாருடைய குரலைப் பயன்படுத்த வேண்டும்?</string>
    <string name="voice_screen_body">ஒன்றைத் தட்டி அது ஒரு வரியைப் படிப்பதைக் கேளுங்கள்.</string>
    <string name="onboarding_voice_sample_line">எனக்கு Ola கிடைத்தது. இப்போது திறக்கிறேன்.</string>
    <string name="use_this_voice">இந்த குரலைப் பயன்படுத்து</string>

    <string name="mic_screen_title">நான் மைக்ரோஃபோனைப் பயன்படுத்தலாமா?</string>
    <string name="mic_screen_body">நீங்கள் என்னிடம் பேசும் போது மட்டுமே. நான் பின்னணியில் கேட்க மாட்டேன், மற்றும் பணி முடிந்த பிறகு எதுவும் பதிவு செய்யப்படாது.</string>
    <string name="mic_screen_note_prefix">Android அடுத்து உங்களிடம் கேட்கும். தேர்வு செய்யுங்கள் </string>
    <string name="mic_screen_note_highlight">\"ஆப்பைப் பயன்படுத்தும்போது\".</string>
    <string name="allow_microphone">மைக்ரோஃபோனை அனுமதிக்கவும்</string>

    <string name="a11y_screen_title">திரையை படிக்க அனுமதியுங்கள்</string>
    <string name="a11y_screen_body">Handrail ஒரு அணுகல்தன்மை சேவை. இது உங்கள் திரையில் உள்ள லேபிள்களைப் படிக்கிறது — படங்களை ஒருபோதும் இல்லை, உங்கள் கீபோர்டை ஒருபோதும் இல்லை.</string>
    <string name="a11y_row_1">பொத்தான் மற்றும் உரை லேபிள்களைப் படிக்கிறது</string>
    <string name="a11y_row_2">உங்களுக்காக தட்டி தட்டச்சு செய்கிறது</string>
    <string name="a11y_row_3">ஸ்கிரீன்ஷாட் அல்லது புகைப்படங்களை ஒருபோதும் எடுக்காது</string>
    <string name="open_android_settings">Android அமைப்புகளைத் திற</string>
    <string name="a11y_settings_path">அமைப்புகள் → அணுகல்தன்மை → Handrail → ஆன்</string>

    <string name="assistant_screen_title">எனக்காக ஹோம் பொத்தானை அழுத்திப் பிடியுங்கள்</string>
    <string name="assistant_screen_body">Handrail-ஐ உங்கள் உதவியாளராக்குங்கள், ஹோம் பொத்தானை அழுத்திப் பிடித்தால் நீங்கள் என்ன செய்தாலும் அதன் மேல் நான் வருவேன்.</string>
    <string name="set_as_assistant">உதவியாளராக அமை</string>

    <string name="my_promise">என் வாக்குறுதி</string>
    <string name="promise_headline">நான் ஒருபோதும் உங்கள் பணத்தை செலவழிக்க மாட்டேன்.</string>
    <string name="promise_body_prefix">நான் ஆப்களைத் திறக்க முடியும், படிவங்களை நிரப்ப முடியும், உங்கள் சவாரியைத் தேர்வு செய்ய முடியும். ஆனால் எந்த பணம் செலுத்துதல், அனுப்புதல், உறுதிப்படுத்துதலுக்கு முன்பும் — நான் நிறுத்துகிறேன், என்ன நடக்கப் போகிறது என்று உரக்கச் சொல்கிறேன், மேலும் </string>
    <string name="promise_body_you">நீங்கள்</string>
    <string name="promise_body_suffix"> கடைசி தட்டலைச் செய்கிறீர்கள்.</string>
    <string name="promise_cta">எனக்குப் புரிந்தது — செல்வோம்</string>
