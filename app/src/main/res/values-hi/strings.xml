    <string name="welcome_kicker">रुकिए। मैं आपको साथ लेकर चलूँगा।</string>
    <string name="welcome_body">मुझे बताएं आप क्या करना चाहते हैं, अपनी भाषा में। मैं स्क्रीन को ज़ोर से पढ़कर सुनाता हूँ, या आपके लिए टैप करता हूँ — और हर कदम उठाने से पहले बताता हूँ।</string>
    <string name="begin">शुरू करें</string>
    <string name="welcome_footer">लगभग एक मिनट लगेगा · चार अनुमतियाँ</string>

    <string name="language_screen_title">मुझे कौन सी भाषा बोलनी चाहिए?</string>
    <string name="language_screen_body">मैं इसी भाषा में सुनूँगा भी। इसे कभी भी सेटिंग्स में बदल सकते हैं।</string>
    <string name="language_screen_count">%1$d भाषाएं · Sarvam और जोड़ेगा</string>

    <string name="voice_screen_title">मुझे किसकी आवाज़ में बोलना चाहिए?</string>
    <string name="voice_screen_body">किसी एक पर टैप करें और उसे एक पंक्ति पढ़ते हुए सुनें।</string>
    <string name="onboarding_voice_sample_line">मुझे Ola मिल गया। इसे अभी खोल रहा हूँ।</string>
    <string name="use_this_voice">यह आवाज़ इस्तेमाल करें</string>

    <string name="mic_screen_title">क्या मैं माइक्रोफ़ोन इस्तेमाल कर सकता हूँ?</string>
    <string name="mic_screen_body">सिर्फ़ तब जब आप मुझसे बात कर रहे हों। मैं पृष्ठभूमि में नहीं सुनता, और कार्य समाप्त होने के बाद कुछ भी रिकॉर्ड नहीं रहता।</string>
    <string name="mic_screen_note_prefix">Android अब आपसे पूछेगा। चुनें </string>
    <string name="mic_screen_note_highlight">\"ऐप इस्तेमाल करते समय\"।</string>
    <string name="allow_microphone">माइक्रोफ़ोन की अनुमति दें</string>

    <string name="a11y_screen_title">मुझे स्क्रीन पढ़ने दें</string>
    <string name="a11y_screen_body">Handrail एक एक्सेसिबिलिटी सेवा है। यह आपकी स्क्रीन पर लिखे लेबल पढ़ती है — कभी तस्वीरें नहीं, कभी आपका कीबोर्ड नहीं।</string>
    <string name="a11y_row_1">बटन और टेक्स्ट लेबल पढ़ती है</string>
    <string name="a11y_row_2">आपकी ओर से टैप और टाइप करती है</string>
    <string name="a11y_row_3">कभी स्क्रीनशॉट या फ़ोटो नहीं लेती</string>
    <string name="open_android_settings">Android सेटिंग्स खोलें</string>
    <string name="a11y_settings_path">सेटिंग्स → एक्सेसिबिलिटी → Handrail → चालू</string>

    <string name="assistant_screen_title">मेरे लिए होम बटन दबाए रखें</string>
    <string name="assistant_screen_body">Handrail को अपना सहायक बनाएं, ताकि होम बटन दबाए रखने पर मैं आप जो भी कर रहे हों उसके ऊपर सामने आ जाऊँ।</string>
    <string name="set_as_assistant">सहायक के रूप में सेट करें</string>

    <string name="my_promise">मेरा वादा</string>
    <string name="promise_headline">मैं कभी आपका पैसा खर्च नहीं करता।</string>
    <string name="promise_body_prefix">मैं ऐप खोल सकता हूँ, फ़ॉर्म भर सकता हूँ और आपकी सवारी चुन सकता हूँ। लेकिन किसी भी भुगतान, भेजने या पुष्टि से पहले — मैं रुकता हूँ, ज़ोर से बताता हूँ कि क्या होने वाला है, और </string>
    <string name="promise_body_you">आप</string>
    <string name="promise_body_suffix"> आखिरी टैप करते हैं।</string>
    <string name="promise_cta">मैं समझ गया — चलिए शुरू करते हैं</string>
