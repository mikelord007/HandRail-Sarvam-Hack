    <string name="promise_headline">ನಾನು ಎಂದಿಗೂ ನಿಮ್ಮ ಹಣ ಖರ್ಚು ಮಾಡುವುದಿಲ್ಲ.</string>
    <string name="promise_body_prefix">ನಾನು ಆ್ಯಪ್‌ಗಳನ್ನು ತೆರೆಯಬಲ್ಲೆ, ಫಾರ್ಮ್‌ಗಳನ್ನು ಭರ್ತಿ ಮಾಡಬಲ್ಲೆ ಮತ್ತು ನಿಮ್ಮ ಸವಾರಿಯನ್ನು ಆಯ್ಕೆ ಮಾಡಬಲ್ಲೆ. ಆದರೆ ಯಾವುದೇ ಪಾವತಿ, ಕಳುಹಿಸುವಿಕೆ, ದೃಢೀಕರಣಕ್ಕೆ ಮುನ್ನ — ನಾನು ನಿಲ್ಲುತ್ತೇನೆ, ಏನಾಗಲಿದೆ ಎಂದು ಗಟ್ಟಿಯಾಗಿ ಹೇಳುತ್ತೇನೆ, ಮತ್ತು </string>
    <string name="promise_body_you">ನೀವು</string>
    <string name="promise_body_suffix"> ಕೊನೆಯ ಟ್ಯಾಪ್ ಮಾಡುತ್ತೀರಿ.</string>
    <string name="promise_cta">ನನಗೆ ಅರ್ಥವಾಯಿತು — ಹೋಗೋಣ</string>
