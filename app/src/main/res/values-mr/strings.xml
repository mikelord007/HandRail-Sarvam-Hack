    <string name="mic_screen_title">मी मायक्रोफोन वापरू शकतो का?</string>
    <string name="mic_screen_body">फक्त तुम्ही माझ्याशी बोलत असताना. मी पार्श्वभूमीत ऐकत नाही, आणि काम संपल्यानंतर काहीही रेकॉर्ड होत नाही.</string>
    <string name="mic_screen_note_prefix">Android पुढे तुम्हाला विचारेल. निवडा </string>
    <string name="mic_screen_note_highlight">\"अ‍ॅप वापरताना\".</string>
    <string name="allow_microphone">मायक्रोफोनला परवानगी द्या</string>

    <string name="a11y_screen_title">मला स्क्रीन वाचू द्या</string>
    <string name="a11y_screen_body">Handrail ही एक अ‍ॅक्सेसिबिलिटी सेवा आहे. ती तुमच्या स्क्रीनवरील लेबल वाचते — कधीही चित्रे नाही, कधीही तुमचा कीबोर्ड नाही.</string>
    <string name="a11y_row_1">बटण आणि मजकूर लेबल वाचते</string>
    <string name="a11y_row_2">तुमच्या वतीने टॅप आणि टाइप करते</string>
    <string name="a11y_row_3">कधीही स्क्रीनशॉट किंवा फोटो घेत नाही</string>
    <string name="open_android_settings">Android सेटिंग्ज उघडा</string>
    <string name="a11y_settings_path">सेटिंग्ज → अ‍ॅक्सेसिबिलिटी → Handrail → चालू</string>

    <string name="assistant_screen_title">माझ्यासाठी होम बटण दाबून धरा</string>
    <string name="assistant_screen_body">Handrail ला तुमचा सहाय्यक बनवा, म्हणजे होम बटण दाबून धरल्यावर तुम्ही जे काही करत असाल त्यावर मी येईन.</string>
    <string name="set_as_assistant">सहाय्यक म्हणून सेट करा</string>

    <string name="my_promise">माझे वचन</string>
    <string name="promise_headline">मी कधीही तुमचे पैसे खर्च करत नाही.</string>
    <string name="promise_body_prefix">मी अ‍ॅप्स उघडू शकतो, फॉर्म भरू शकतो आणि तुमची राईड निवडू शकतो. पण कोणत्याही पेमेंट, पाठवण्याआधी, पुष्टीकरणाआधी — मी थांबतो, काय होणार आहे ते मोठ्याने सांगतो, आणि </string>
    <string name="promise_body_you">तुम्ही</string>
    <string name="promise_body_suffix"> शेवटचा टॅप करता.</string>
